/* ===========================
   MeowGames07 - STYLE PART 1
=========================== */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:Arial, Helvetica, sans-serif;
    background:#111827;
    color:#fff;
}

a{
    text-decoration:none;
    color:#fff;
}

img{
    max-width:100%;
    display:block;
}

/* Header */

.header{
    position:sticky;
    top:0;
    z-index:1000;
    background:#1f2937;
    padding:18px;
    box-shadow:0 2px 10px rgba(0,0,0,.4);
}

.logo{
    font-size:30px;
    font-weight:bold;
    text-align:center;
    color:#00e5ff;
    margin-bottom:15px;
}

/* Search */

#search{
    width:100%;
    max-width:700px;
    display:block;
    margin:10px auto;
    padding:14px 20px;
    border:none;
    outline:none;
    border-radius:50px;
    background:#374151;
    color:#fff;
    font-size:17px;
}

#search::placeholder{
    color:#bbb;
}

/* Categories */

.categories{
    display:flex;
    justify-content:center;
    gap:10px;
    flex-wrap:wrap;
    margin-top:15px;
}

.categories button{
    background:#2563eb;
    color:white;
    border:none;
    padding:10px 18px;
    border-radius:25px;
    cursor:pointer;
    transition:.3s;
    font-size:15px;
}

.categories button:hover{
    background:#1d4ed8;
    transform:scale(1.05);
}

/* Games Grid */

.games{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
    gap:20px;
    padding:20px;
  /* ===========================
   MeowGames07 - STYLE PART 2
   Game Cards
=========================== */

.card{
    background:#1f2937;
    border-radius:18px;
    overflow:hidden;
    transition:.3s;
    box-shadow:0 8px 20px rgba(0,0,0,.35);
}

.card:hover{
    transform:translateY(-8px) scale(1.03);
    box-shadow:0 15px 30px rgba(0,0,0,.5);
}

.card img{
    width:100%;
    height:170px;
    object-fit:cover;
}

.card h3{
    text-align:center;
    font-size:20px;
    margin:15px 0;
    color:#fff;
}

.card a{
    display:block;
    width:85%;
    margin:0 auto 18px;
    text-align:center;
    background:#00c853;
    color:#fff;
    padding:12px;
    border-radius:12px;
    font-weight:bold;
    transition:.3s;
}

.card a:hover{
    background:#00a844;
}

.card p{
    color:#bdbdbd;
    text-align:center;
    font-size:14px;
    margin:0 12px 15px;
}

/* Scrollbar */

::-webkit-scrollbar{
    width:10px;
}

::-webkit-scrollbar-track{
    background:#111827;
}

::-webkit-scrollbar-thumb{
    background:#3b82f6;
    border-radius:10px;
}

::-webkit-scrollbar-thumb:hover{
    background:#2563eb;
/* ===========================
   MeowGames07 - STYLE PART 3
   Responsive + Footer
=========================== */

/* Footer */

footer{
    background:#1f2937;
    text-align:center;
    padding:25px;
    margin-top:40px;
    color:#ccc;
    font-size:15px;
}

/* Tablet */

@media (max-width:992px){

.games{
grid-template-columns:repeat(3,1fr);
gap:18px;
}

.logo{
font-size:28px;
}

}

/* Mobile */

@media (max-width:768px){

.header{
padding:15px;
}

.logo{
font-size:24px;
}

#search{
width:100%;
font-size:16px;
padding:12px 18px;
}

.categories{
gap:8px;
}

.categories button{
padding:8px 14px;
font-size:14px;
}

.games{
grid-template-columns:repeat(2,1fr);
gap:15px;
padding:15px;
}

.card img{
height:140px;
}

.card h3{
font-size:17px;
}

.card a{
padding:10px;
font-size:15px;
}

}

/* Small Mobile */

@media (max-width:480px){

.games{
grid-template-columns:1fr;
}

.logo{
font-size:22px;
}

.card img{
height:190px;
}

footer{
font-size:13px;
padding:20px;
}

}

/* Smooth Animation */

.card{
animation:fadeIn .5s ease;
}

@keyframes fadeIn{

0%{
opacity:0;
transform:translateY(20px);
}

100%{
opacity:1;
transform:translateY(0);
}
/* ===========================
   MeowGames07 - STYLE PART 4
   Final UI & Premium Effects
=========================== */

/* Active Category Button */

.categories button.active{
    background:#00c853;
    color:#fff;
}

/* Play Button Gradient */

.card a{
    background:linear-gradient(45deg,#00c853,#00e676);
}

.card a:hover{
    background:linear-gradient(45deg,#00e676,#00c853);
}

/* Card Glow */

.card:hover{
    border:2px solid #00e5ff;
    box-shadow:
    0 0 15px rgba(0,229,255,.5),
    0 0 35px rgba(0,229,255,.25);
}

/* Search Focus */

#search:focus{
    border:2px solid #00e5ff;
    box-shadow:0 0 15px rgba(0,229,255,.5);
}

/* Smooth Scroll */

html{
    scroll-behavior:smooth;
}

/* Selection Color */

::selection{
    background:#00c853;
    color:#fff;
}

/* Footer Hover */

footer a{
    color:#00e5ff;
    text-decoration:none;
}

footer a:hover{
    color:#00c853;
}

/* Logo Animation */

.logo{
    animation:logoGlow 2s infinite alternate;
}

@keyframes logoGlow{

0%{
text-shadow:0 0 5px #00e5ff;
}

100%{
text-shadow:
0 0 15px #00e5ff,
0 0 35px #00e5ff;
}

}

/* Page Fade */

body{
    animation:pageLoad .6s ease;
}

@
}
